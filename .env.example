# ============================================================
# SınavPlan — örnek ortam dosyası
#   cp .env.example .env && docker compose up --build
# Buradaki sırlar YALNIZCA yerel geliştirme/değerlendirme içindir.
# ============================================================

# ---- Uygulama ----
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=15s

# ---- PostgreSQL ----
# Veritabanı host'a açılmaz; yalnızca compose ağından erişilir.
POSTGRES_DB=sinavplan
POSTGRES_USER=sinavplan
POSTGRES_PASSWORD=sinavplan_local_dev_pw

# Uygulamanın kullandığı kısıtlı rol. audit_log üzerinde UPDATE/DELETE yetkisi
# YOKTUR (append-only denetim kaydı için, bkz. DECISIONS ADR-005).
APP_DB_USER=sinavplan_app
APP_DB_PASSWORD=sinavplan_app_local_dev_pw

# api ve simulator bu DSN ile bağlanır (kısıtlı rol).
DATABASE_URL=postgres://sinavplan_app:sinavplan_app_local_dev_pw@postgres:5432/sinavplan?sslmode=disable
# migrate servisi şema değiştirdiği için sahip rolle bağlanır.
MIGRATE_DATABASE_URL=postgres://sinavplan:sinavplan_local_dev_pw@postgres:5432/sinavplan?sslmode=disable

# ---- Kimlik ve sırlar (en az 32 karakter) ----
JWT_SECRET=local_dev_jwt_secret_change_me_0123456789abcdef
# Dinamik QR: sinav karti jetonunun omru (arayuz bundan once yeniler). 15sn..1sa
QR_TTL=2m
QR_HMAC_SECRET=local_dev_qr_hmac_secret_change_me_0123456789abcd
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# ---- Simülatör / seed ----
# Aynı tohum her zaman aynı veriyi üretir (proje.md §8).
SEED=42
SIM_EXAMS=300
SIM_STUDENTS=8000
SIM_ROOMS=60
# "live" modunun sıkıştırılmış süresi; make verify'ın 15 dk sınırında kalması için.
SIM_LIVE_DURATION=2m

# ---- Çizelgeleme varsayılanları ----
SCHEDULING_DAYS=15
SCHEDULING_SESSIONS_PER_DAY=3
SCHEDULING_TIME_LIMIT=15s
# T-3 "sıkı mod": ön/arka koltukları da komşu sayar. proje.md §6 yalnızca
# "yan yana" diyor, bu yüzden varsayılan kapalı (bkz. PROJECT_PLAN V-1).
SEATING_STRICT_MODE=false

# ---- Frontend ----
FRONTEND_PORT=3000
# API'nin bilgisayarinizdaki portu. 8080 doluysa 8081 yapin; arayuz /api uzerinden kendi icinden baglanir.
API_PORT=8080
VITE_API_BASE_URL=/api

# ============================================================
# Demo hesapları (seed tarafından oluşturulur) — TESTING.md'de de listelidir
# ============================================================
DEMO_PASSWORD=Demo!1234
# secretary        seed.mercan@ddo-case.invalid       Demo!1234
# lecturer         hoca@sinavplan.test           Demo!1234
# invigilator      gozetmen@sinavplan.test       Demo!1234
# student_affairs  ogrenciisleri@sinavplan.test  Demo!1234
# student          ogrenci@sinavplan.test        Demo!1234
